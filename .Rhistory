# expect_equal(p_value_g, 0.7241)
# (2) Monotone Positive Missingness
set.seed(1)
M0 <- as.numeric(Y0 <= qnorm(0.92))
M1 <- as.numeric(Y0 <= qnorm(0.98))
Z <- sample(c(rep(1, N/2), rep(0, N/2)))
M <- Z * M1 + (1 - Z) * M0
Y <- Z * Y1 + (1 - Z) * Y0 # No missing value
