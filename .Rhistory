use_testthat()
use_test("pval_sharp")
set.seed(1)
N <- 500
Y0 <- rnorm(N, 0, 1)
Y1 <- Y0
Z.perm <- assign_CRE(n = N, m = N/2, nperm = 10^4)
stat.null <- null_dist(n = N, m = N/2, MWU = FALSE, method.list = list(name = "Wilcoxon"), Z.perm = Z.perm, nperm = 10^4)
# (1) Threshold Missingness Pattern
# Generate simulated missing data
# Specify threshold selection rule Mi(0) = 1{Yi(0) <= qnorm(0.95)}, Mi(1) = 1{Yi(1) >= qnorm(0.05)}
set.seed(1)
M0 <- as.numeric(Y0 <= qnorm(0.95))
M1 <- as.numeric(Y1 >= qnorm(0.05))
Z <- sample(c(rep(1, N/2), rep(0, N/2)))
M <- Z * M1 + (1 - Z) * M0
Y <- Z * Y1 + (1 - Z) * Y0 # No missing value
Y_observed <- ifelse(M == 0, NA, Y)
p_value_g <- pval_sharp(Z, Y_observed, c = 0, missing = "general", MWU = FALSE,
method.list = list(name = "Wilcoxon"),
stat.null = NULL, Z.perm = NULL, nperm = 10^4)
p_value_g
set.seed(1)
N <- 500
Y0 <- rnorm(N, 0, 1)
Y1 <- Y0
Z.perm <- assign_CRE(n = N, m = N/2, nperm = 10^4)
stat.null <- null_dist(n = N, m = N/2, MWU = FALSE, method.list = list(name = "Wilcoxon"), Z.perm = Z.perm, nperm = 10^4)
# (1) Threshold Missingness Pattern
# Generate simulated missing data
# Specify threshold selection rule Mi(0) = 1{Yi(0) <= qnorm(0.95)}, Mi(1) = 1{Yi(1) >= qnorm(0.05)}
set.seed(1)
M0 <- as.numeric(Y0 <= qnorm(0.95))
M1 <- as.numeric(Y1 >= qnorm(0.05))
Z <- sample(c(rep(1, N/2), rep(0, N/2)))
M <- Z * M1 + (1 - Z) * M0
Y <- Z * Y1 + (1 - Z) * Y0 # No missing value
